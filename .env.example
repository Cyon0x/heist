# ---------------------------------------------------------------------------
# HEIST — environment. Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_URL=http://localhost:4320
NODE_ENV=development

# --- Database --------------------------------------------------------------
# Postgres (Neon/Supabase/any). Required in production; without it HEIST boots
# on an in-memory store and the UI shows an EPHEMERAL STORE badge.
# HEIST_DATABASE_URL=postgresql://user:pass@host:5432/heist?sslmode=require
DATABASE_URL=

# --- Sessions + managed-wallet encryption ----------------------------------
# 32+ random chars each: openssl rand -base64 32
SESSION_SECRET=
WALLET_ENCRYPTION_KEY=

# --- Arc (mainnet | testnet) -----------------------------------------------
NEXT_PUBLIC_ARC_NETWORK=mainnet
# NEXT_PUBLIC_ARC_RPC_URL=            # override only if you run your own node
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Escrow / settlement (server-only) -------------------------------------
# Deployed HeistEscrow address. Empty disables paid settlement.
HEIST_ESCROW_ADDRESS=
# EIP-712 attestor key. NEVER expose to the browser.
SETTLEMENT_PRIVATE_KEY=
# Where the 10% protocol fee goes.
PROTOCOL_TREASURY_ADDRESS=
# 900 = 90% to the winner.
PROTOCOL_FEE_BPS=1000

# --- OAuth (optional) ------------------------------------------------------
# Redirect URI: https://<APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI: https://<APP_URL>/api/auth/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Realtime --------------------------------------------------------------
# Where the browser opens its authoritative socket (`wss://…` in production).
# Unset = local authority (two tabs on one machine, staking refused).
# Read at runtime, so changing it does not require a rebuild.
GAME_SERVER_URL=
NEXT_PUBLIC_GAME_SERVER_URL=
# HMAC key for room tickets. Must be identical on the web app and the game
# server. The browser never sees it — it only ever receives a signed ticket.
GAME_SERVER_SECRET=

# --- Game server (only read by `npm run game:server`) ----------------------
GAME_SERVER_PORT=4331
GAME_SERVER_MAX_ROOMS=400

# --- Cron ------------------------------------------------------------------
CRON_SECRET=

# --- Authoritative game server --------------------------------------------
# Port the Node ws game server binds (npm run game:server).
GAME_SERVER_PORT=4331
# Shared secret; clients pass it as ?key= on the WebSocket URL.
GAME_SERVER_SECRET=
# Refuse new rooms past this many concurrent matches.
GAME_SERVER_MAX_ROOMS=400
